# Nabdh backend — required environment variable names.
# Copy to .env and fill in values. Never commit .env.

# --- AI provider (ranking + weekly brief; deterministic fallbacks used when absent) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_MS=8000

# --- Database (local dev via `docker compose up -d`, deployed via DATABASE_URL secret) ---
DATABASE_URL=postgresql://nabdh:nabdh@localhost:5432/nabdh
PG_SSL=false

# --- Search provider (none | tavily | serper; seed data is returned when unset/unavailable) ---
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPER_API_KEY=
SEARCH_TIMEOUT_MS=5000

# --- Server ---
PORT=3000
CORS_ORIGIN=*
