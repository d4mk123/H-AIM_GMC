# Nabdh backend — environment variable names.
# Copy to .env and fill in values. Never commit .env.

# --- AI provider (ranking + weekly brief; deterministic fallbacks used when absent) ---
# Primary: NVIDIA NIM. AI_BASE_URL defaults to https://integrate.api.nvidia.com/v1
# when left empty, so NVIDIA users only need the key and the model.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_BASE_URL=
AI_TIMEOUT_MS=60000

# Alternate: Groq. Chosen automatically when NVIDIA_API_KEY is empty and
# GROQ_API_KEY is set — AI_BASE_URL then defaults to https://api.groq.com/openai/v1
# (setting AI_BASE_URL explicitly always wins). Verified working models on a
# free account: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b.
#   GROQ_API_KEY=
#   GROQ_MODEL=openai/gpt-oss-120b

# Ranking behaviour
RANK_CACHE=1
RANK_CACHE_TTL_MS=300000
# Only the closest candidates are sent to the model, the rest is ordered by
# tag overlap: keeps model latency sane on a 30+ item feed.
RANK_PRE_FILTER_LIMIT=12
RANK_FORCE_FALLBACK=0

# --- Database (local dev via `docker compose up -d`, deployed via DATABASE_URL secret) ---
DATABASE_URL=postgresql://nabdh:nabdh@localhost:5432/nabdh
PG_SSL=false

# --- Search provider (none | tavily | serper; local db/seed results when unset/unavailable) ---
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPER_API_KEY=
SEARCH_TIMEOUT_MS=5000
SEARCH_CACHE=1
SEARCH_CACHE_TTL_MS=300000
# Optional endpoint overrides — used by tests and local mocks.
TAVILY_BASE_URL=
SERPER_BASE_URL=

# --- Weekly brief ---
# Set to 1 to skip the model and always build the deterministic brief.
BRIEF_FORCE_FALLBACK=0
# Most relevant items sent to the model for the brief (rest still feed the
# deterministic fallback): a 30-item brief exceeds AI_TIMEOUT_MS on slow models.
BRIEF_ITEM_LIMIT=12

# --- Server ---
PORT=3000
CORS_ORIGIN=*
